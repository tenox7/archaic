#!/bin/sh
# mkmint - build Archaic for the Atari with FreeMiNT and GEM (XaAES), as on
# ARAnyM, in Docker: Vincent Riviere's m68k-atari-mint cross tools (gcc
# 4.6.4, MiNTLib, GEMLib) from his Ubuntu PPA (ppa:vriviere/ppa). The image
# archaic-mint is made the first time (amd64; on Apple silicon Docker runs
# it with Rosetta). Run it on the host, not on the Atari. It makes
# archaic-mint (next to src): a MiNT program for a 68000 or newer. In MiNT
# it goes in /usr/local/bin/archaic. It links in /tmp in the container and
# copies the result: a file replaced on a network drive (strip) leaves
# .nfs files while Docker holds it.
cd "$(dirname "$0")/.." || exit 1
docker image inspect archaic-mint >/dev/null 2>&1 ||
docker build --platform linux/amd64 -t archaic-mint - <<'END' || exit 1
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common gpg-agent && \
	add-apt-repository -y ppa:vriviere/ppa && apt-get update && \
	apt-get install -y --no-install-recommends cross-mint-essential gemlib-m68k-atari-mint && \
	rm -rf /var/lib/apt/lists/*
END
docker run --rm --platform linux/amd64 -v "$PWD":/a -w /a/src archaic-mint sh -c '
	m68k-atari-mint-gcc -O2 -Wall -Wno-unused-parameter -o /tmp/archaic \
		main.c html.c http.c gif.c pic.c update.c fb.c gem.c nsock.c -lgem &&
	m68k-atari-mint-strip /tmp/archaic &&
	m68k-atari-mint-stack -S 128k /tmp/archaic >/dev/null &&
	cp /tmp/archaic ../archaic-mint' || exit 1
ls -l archaic-mint
