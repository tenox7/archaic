#!/bin/sh
# mktos - build Archaic for the Atari with TOS and GEM, on any ST, STE,
# TT or Falcon, with STinG's TCP (a NetUSBee or an EtherNEC card), in
# Docker: the same cross tools as mkmint (the image archaic-mint, made
# by mkmint the first time). Run it on the host, not on the Atari. It
# makes archaic-tos.prg (next to src): a GEM program for a 68000 or newer,
# ARCHAIC.PRG on the Atari. tos.c has main(): main.c's main is
# archaic_main. It links in /tmp in the container and copies the result
# (see mkmint).
cd "$(dirname "$0")/.." || exit 1
docker image inspect archaic-mint >/dev/null 2>&1 || {
	echo "mktos: no image archaic-mint: run sh src/mkmint once" >&2
	exit 1
}
docker run --rm --platform linux/amd64 -v "$PWD":/a -w /a/src archaic-mint sh -c '
	F="-O2 -Wall -Wno-unused-parameter -DATARITOS"
	m68k-atari-mint-gcc $F -Dmain=archaic_main -c -o /tmp/main.o main.c &&
	m68k-atari-mint-gcc $F -o /tmp/archaic /tmp/main.o \
		html.c http.c gif.c pic.c update.c tos.c nsting.c -lgem &&
	m68k-atari-mint-strip /tmp/archaic &&
	m68k-atari-mint-stack -S 128k /tmp/archaic >/dev/null &&
	cp /tmp/archaic ../archaic-tos.prg' || exit 1
ls -l archaic-tos.prg
