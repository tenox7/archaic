# mksunview - build Archaic on SunOS 4 for SunView: sh mksunview
# cc is Sun's own C compiler (K&R: -DNOPROTO). SunView's libraries:
# suntool (the toolkit), sunwindow (windows, the notifier), pixrect.
# The network is BSD sockets (nsock.c).
CC=cc
$CC -O -DNOPROTO -DSUNVIEW -c main.c html.c http.c gif.c pic.c nsock.c sunview.c &&
$CC -o archaic main.o html.o http.o gif.o pic.o nsock.o sunview.o -lsuntool -lsunwindow -lpixrect &&
ls -l archaic
