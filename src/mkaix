# mkaix - build Archaic on AIX 3.2 (RS/6000) for X11: sh mkaix
# cc is IBM's XL C (1.3 in the kit). gcc 2.7.2 builds it too:
# CC=gcc sh mkaix. X11R5 (AIXwindows) is on the default paths.
# The network is BSD sockets (nsock.c), in libc.
CC=${CC-cc}
$CC -O -c main.c html.c http.c gif.c pic.c update.c nsock.c x11.c &&
$CC -o archaic main.o html.o http.o gif.o pic.o update.o nsock.o x11.o -lX11 &&
ls -l archaic
